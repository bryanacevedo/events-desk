{
  "name": "events-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Takes a conference from seat request to a delivered prospect list. AI in the input and the decision, a human on every paid step.",
  "scripts": {
    "dev": "concurrently -k -n api,app \"node --watch src/server/node.ts --demo\" \"vite\"",
    "build": "vite build",
    "demo": "vite build && node src/server/node.ts --demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "node scripts/audit-layout.mjs",
    "start": "node --env-file-if-exists=.env src/server/node.ts",
    "migrate": "node --env-file-if-exists=.env src/server/node.ts --migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "exceljs": "^4.4.0",
    "hono": "^4.6.14",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.49.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Bryan Acevedo",
  "engines": {
    "node": ">=22.18"
  }
}
