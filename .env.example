# Names only. `make demo` needs none of these and ignores them all.
# Read from .env by `npm start` and `npm run migrate`.
DATABASE_URL=

# Optional, for API-only use. The web app does not send it, so leave it empty if people use the screens.
WRITE_KEY=

# Real spend. The server refuses to start with LIVE_SPEND=1 unless every required line below is set. Lines marked Optional are not required.
LIVE_SPEND=
# Optional. Defaults to claude-opus-5-5.
EVENTS_DESK_MODEL=
# Optional. Only for a key that is not scoped to one workspace.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=
# Apollo does the matching and runs the email waterfall. ZeroBounce validates. These are the only two email vendors the code calls.
# Other sources (Hunter, for one) can sit inside Apollo's waterfall, chosen in Apollo's settings, not here.
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APPROVALS_CHANNEL=
# Where problems that belong to no one event go (a tool gone quiet, a stuck pass). Defaults to the approvals channel. Each event gets its own channel, opened by the desk.
SLACK_OPS_CHANNEL=
# Leadership only: seat requests and seat approvals. Defaults to the approvals channel. Cost cards go to the event's own channel, to the SDR who uploaded the list.
SLACK_SEATS_CHANNEL=
# The desk's own address, such as https://desk.example.com. Event channel topics link to the event's page with it. Without it, the topic has no link.
APP_URL=

# Real sending (after delivery). Off unless LIVE_SEND=1, and then it refuses to start without every line below.
# DESK_LOGIN=1 says a real login protects the desk; none is built yet, so leave it unset.
LIVE_SEND=
DESK_LOGIN=
WEBHOOK_BASE=
SEQUENCER_WEBHOOK_SECRET=
INSTANTLY_API_KEY=
HEYREACH_API_KEY=
SMARTLEAD_API_KEY=
APPROVER_SLACK_IDS=
# Who confirms a cost card is the person who uploaded the list, and in live mode the Slack user is the proof. JSON, person name to Slack user ID,
# for everyone who uploads lists: {"Maya Ortiz": "U01ABC123"}. Required for LIVE_SPEND=1. APPROVER_SLACK_IDS now covers seat requests only.
SLACK_USER_MAP=

# Google Sheet delivery. LIVE_SPEND=1 needs ONE complete sign-in below, not both.
# Click-by-click setup: docs/GOOGLE-SETUP.md

# Sign-in A, a personal Gmail (OAuth). The file is made in your own Drive.
# Get the refresh token with: make google-auth OUT=<a new file name>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional with sign-in A. Comma-separated addresses that get each Sheet as editors. Empty means private to you.
GOOGLE_SHARE_EMAILS=

# Sign-in B, a Workspace service account.
# The whole service account key file, pasted as one line of JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
# A folder inside a Shared Drive. Service accounts cannot own files in My Drive.
GOOGLE_DRIVE_FOLDER_ID=
# Each Sheet is shared with this domain as editors, for example example.com. Never "anyone with the link".
GOOGLE_SHARE_DOMAIN=

# Spend limits. Both are optional; the defaults are deliberately small.
# A live run refuses an event with more source rows than this (default 4).
REAL_RUN_MAX_ROWS=
# `make evals-live` makes at most this many real model calls (default 8). A full re-record needs the whole list size.
EVALS_MAX_ITEMS=

# Optional. A link to show on delivered sample events in the demo. Never hard-coded.
SAMPLE_SHEET_URL=
# Optional. With a DATABASE_URL, set to 1 to load the sample events into an empty database.
SEED_SAMPLE=
# No Salesforce key exists: nothing in the code connects to Salesforce, and live mode runs no Salesforce check.

# The app has no login, so it listens on this machine only. Set HOST only behind your own access control.
# HOST=127.0.0.1
